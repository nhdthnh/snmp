# ==============================================================================
# NETMON - FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế của bạn:
#   copy .env.example .env
# ==============================================================================

# Khóa Gemini API phân tích lưu lượng mạng (cách nhau bởi dấu phẩy nếu nhiều key)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Cổng Web UI (mặc định 8088)
NETMON_PORT=8088

# Chu kỳ lấy mẫu SNMP (giây) & số ngày lưu trữ dữ liệu
NETMON_INTERVAL=30
NETMON_RETENTION=7

# Cấu hình AI phân tích
NETMON_AI_MODEL=gemma-4-31b-it
NETMON_AI_INTERVAL=1800

# Router MikroTik HQ (Trụ sở chính)
NETMON_ROUTER_IP=192.168.1.1

# Router MikroTik BOB (Chi nhánh kết nối IPsec)
NETMON_BOB_ROUTER_IP=192.168.4.1

# SNMP Community & Timeout
NETMON_SNMP_COMMUNITY=monitoring
NETMON_SNMP_TIMEOUT=2.0
